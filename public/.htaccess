Options -Indexes
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# never execute anything uploaded
<FilesMatch "\.(php|phtml|phar)$">
  <If "%{REQUEST_URI} =~ m#^/uploads/#">
    Require all denied
  </If>
</FilesMatch>

# long-lived caching for static files (assets are versioned with ?v=, uploads have unique names)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilter DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
